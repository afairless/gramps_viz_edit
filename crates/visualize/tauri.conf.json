{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gramps-gen-visualize",
  "version": "0.1.0",
  "identifier": "dev.grampsgen.visualize",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gramps Family Group Visualization",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
